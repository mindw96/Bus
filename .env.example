# Backend arrival provider: fixture or tago
UNIST_BUS_ARRIVALS_MODE=fixture
UNIST_BUS_CACHE_TTL=30s

# Obtain a key through the Public Data Portal. Never commit the real value.
TAGO_SERVICE_KEY=
TAGO_CITY_CODE=26

# Confirmed UNIST TAGO node IDs. They are not the local stop numbers.
TAGO_NODE_40234=USB196040234
TAGO_NODE_40233=USB196040233
TAGO_NODE_40235=USB999000145

# Remote lock-screen updates are disabled by default. Production uses
# Firestore and Application Default Credentials from the Cloud Run service
# account; never commit a service-account JSON key.
UNIST_BUS_TRACKING_STORAGE=memory
UNIST_BUS_TRACKING_COLLECTION=tracking-subscriptions
FIREBASE_PROJECT_ID=

# Required only when UNIST_BUS_TRACKING_STORAGE=firestore.
# Base64 of exactly 32 random bytes; store the real value in Secret Manager.
UNIST_BUS_TRACKING_ENCRYPTION_KEY=

# The worker endpoint stays unavailable until this flag and a refresh key are
# supplied. Inject the key into Cloud Run from Secret Manager; the scheduler
# sends the matching protected header.
UNIST_BUS_PUSH_ENABLED=false
UNIST_BUS_PUSH_REFRESH_KEY=
UNIST_BUS_PUSH_ETA_THRESHOLD=60s
UNIST_BUS_PUSH_MATCH_WINDOW=3m
UNIST_BUS_PUSH_IOS_HEARTBEAT=60s
UNIST_BUS_PUSH_CLAIM_LEASE=30s
UNIST_BUS_PUSH_MAX_LIFETIME=2h
UNIST_BUS_PUSH_ARRIVAL_GRACE=30m

# Firebase Cloud Messaging through the Cloud Run service account.
UNIST_BUS_FCM_ENABLED=false

# ActivityKit APNs provider settings. APNS_AUTH_KEY is the .p8 content supplied
# as a secret, not a path committed to the repository.
UNIST_BUS_APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_AUTH_KEY=
